{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aston.example/schemas/coss-assessment.schema.json",
  "title": "ATI COSS Control Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "tenant_id",
    "control_id",
    "registry_snapshot",
    "status",
    "assessed_at",
    "evidence",
    "review"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 8
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "control_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{1,3}$"
    },
    "registry_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "implemented",
        "partially_implemented",
        "not_implemented",
        "not_assessed",
        "not_applicable"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source",
          "collected_at",
          "sha256",
          "scope"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "collector": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "description",
          "state"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "description": {
            "type": "string"
          },
          "state": {
            "enum": [
              "open",
              "in_progress",
              "accepted_risk",
              "resolved",
              "verified"
            ]
          },
          "owner": {
            "type": "string"
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "description": "Optional internal attestation metadata; never implies CISOKit endorsement or third-party certification.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "internal_self_assessment",
            "independent_review"
          ]
        },
        "organization": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "signed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
