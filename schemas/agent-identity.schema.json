{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aston.example/schemas/agent-identity.schema.json",
  "title": "ASTON CORE 1.0 Agent Identity Passport",
  "description": "Portable, signed identity snapshot for an autonomous agent. This document contains public keys only and is not, by itself, an authorization token.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentId",
    "organization",
    "status",
    "publicKeys",
    "policyRefs",
    "issuedAt",
    "expiresAt",
    "identityVersion",
    "proof"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aston.agent-identity/1.0"
    },
    "agentId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^(urn:uuid:[0-9a-fA-F-]{36}|did:[a-z0-9]+:.+)$",
      "description": "Stable agent identifier. CORE 1.0 permits URN UUID or a syntactically valid DID; DID method resolution is outside this schema."
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "displayName"],
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "issuerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Authenticated organization administrator or issuer identifier."
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended", "revoked"]
    },
    "publicKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/publicKey"
      },
      "description": "Public verification keys only. Private key parameters MUST NOT be included."
    },
    "policyRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "description": "References to separately issued policy grants; these references do not grant authority without online policy validation."
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "identityVersion": {
      "type": "integer",
      "minimum": 1
    },
    "previousIdentityDigest": {
      "$ref": "#/$defs/digest"
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revokedAt", "reasonCode", "revocationEventId"],
      "properties": {
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "revocationEventId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "created", "verificationMethod", "canonicalization", "proofPurpose", "signature"],
      "properties": {
        "type": {
          "const": "JsonWebSignature2020"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Key identifier controlled by the organization issuer."
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "signature": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096,
          "contentEncoding": "base64url",
          "description": "Detached or enveloped signature representation as defined by the implementation profile; the API contract must fix the exact serialization before coding."
        },
        "algorithm": {
          "type": "string",
          "enum": ["EdDSA", "ES256"]
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced non-security extensions. Extensions MUST NOT change authorization semantics.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "revoked" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["revocation"]
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["active", "suspended"] }
        },
        "required": ["status"]
      },
      "then": {
        "not": { "required": ["revocation"] }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "publicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "status", "publicJwk", "validFrom"],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "algorithm": {
          "type": "string",
          "enum": ["EdDSA", "ES256"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "retired", "revoked"]
        },
        "publicJwk": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kty", "crv", "x"],
              "properties": {
                "kty": { "const": "OKP" },
                "crv": { "const": "Ed25519" },
                "x": {
                  "type": "string",
                  "minLength": 43,
                  "maxLength": 43,
                  "contentEncoding": "base64url"
                },
                "use": { "const": "sig" },
                "alg": { "const": "EdDSA" },
                "kid": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kty", "crv", "x", "y"],
              "properties": {
                "kty": { "const": "EC" },
                "crv": { "const": "P-256" },
                "x": {
                  "type": "string",
                  "minLength": 43,
                  "maxLength": 43,
                  "contentEncoding": "base64url"
                },
                "y": {
                  "type": "string",
                  "minLength": 43,
                  "maxLength": 43,
                  "contentEncoding": "base64url"
                },
                "use": { "const": "sig" },
                "alg": { "const": "ES256" },
                "kid": { "type": "string" }
              }
            }
          ]
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "revoked" }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["revokedAt"]
          }
        }
      ]
    }
  }
}
